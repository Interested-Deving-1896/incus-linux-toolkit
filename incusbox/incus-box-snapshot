#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# incus-box-snapshot: create, list, restore, and delete container snapshots.

set -e

# ── shared library ────────────────────────────────────────────────────────────
_lib="$(cd "$(dirname "$0")" && pwd)/lib.sh"
[ -f "${_lib}" ] || _lib="/usr/share/incus-box/lib.sh"
# shellcheck source=lib.sh disable=SC1091
. "${_lib}"

resolve_incus

show_help() {
    cat <<EOF
incus-box-snapshot — manage Incus snapshots for incus-box containers

Usage:
  incus-box-snapshot create  NAME [SNAPSHOT]
  incus-box-snapshot list    NAME
  incus-box-snapshot restore NAME SNAPSHOT
  incus-box-snapshot delete  NAME SNAPSHOT
  incus-box-snapshot auto    <set|show|disable> NAME [options]

Subcommands:
  create   Take a snapshot of container NAME. SNAPSHOT defaults to
           snap-<timestamp> when omitted.
  list     List all snapshots of container NAME.
  restore  Restore container NAME to snapshot SNAPSHOT.
  delete   Delete snapshot SNAPSHOT from container NAME.
  auto     Manage automatic snapshot schedules (delegates to
           incus-box-snapshot-auto).

Options:
  -h, --help    Show this help

Examples:
  incus-box-snapshot create  mybox
  incus-box-snapshot create  mybox before-upgrade
  incus-box-snapshot list    mybox
  incus-box-snapshot restore mybox before-upgrade
  incus-box-snapshot delete  mybox before-upgrade
  incus-box-snapshot auto set    mybox "@daily" --expiry 7d
  incus-box-snapshot auto show   mybox
  incus-box-snapshot auto disable mybox
EOF
}

# ── subcommands ───────────────────────────────────────────────────────────────

cmd_create() {
    local name="$1"
    local snap="${2:-snap-$(date +%Y%m%d-%H%M%S)}"
    [ -z "${name}" ] && { show_help; exit 1; }
    require_incus
    log "Creating snapshot '${snap}' of container '${name}' ..."
    ${INCUS} snapshot create "${name}" "${snap}"
    log "Snapshot created: ${name}/${snap}"
}

cmd_list() {
    local name="$1"
    [ -z "${name}" ] && { show_help; exit 1; }
    require_incus
    ${INCUS} info "${name}" | awk '
        /^Snapshots:/ { in_snap=1; next }
        in_snap && /^[[:space:]]/ { print }
        in_snap && /^[^[:space:]]/ { in_snap=0 }
    '
}

cmd_restore() {
    local name="$1"
    local snap="$2"
    [ -z "${name}" ] || [ -z "${snap}" ] && { show_help; exit 1; }
    require_incus
    log "Restoring '${name}' to snapshot '${snap}' ..."
    ${INCUS} snapshot restore "${name}" "${snap}"
    log "Restored: ${name} → ${snap}"
}

cmd_delete() {
    local name="$1"
    local snap="$2"
    [ -z "${name}" ] || [ -z "${snap}" ] && { show_help; exit 1; }
    require_incus
    log "Deleting snapshot '${snap}' from '${name}' ..."
    ${INCUS} snapshot delete "${name}" "${snap}"
    log "Deleted: ${name}/${snap}"
}

# ── dispatch ──────────────────────────────────────────────────────────────────

[ "$#" -eq 0 ] && { show_help; exit 0; }

subcmd="$1"; shift
case "${subcmd}" in
    create)  cmd_create  "$@" ;;
    list|ls) cmd_list    "$@" ;;
    restore) cmd_restore "$@" ;;
    delete|rm|remove) cmd_delete "$@" ;;
    auto)
        _auto_bin="$(dirname "$0")/incus-box-snapshot-auto"
        [ -x "${_auto_bin}" ] || _auto_bin="incus-box-snapshot-auto"
        exec "${_auto_bin}" "$@" ;;
    -h|--help|help) show_help ;;
    *)
        printf >&2 "incus-box-snapshot: unknown subcommand '%s'\n" "${subcmd}"
        printf >&2 "Run 'incus-box-snapshot --help' for usage.\n"
        exit 1 ;;
esac
